{
  "name": "jessbarrett.ca",
  "version": "1.8.8",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-local-storage": "mkdir -p .tmp",
    "test": "pnpm build-local-storage && NODE_OPTIONS='--localstorage-file=.tmp/testlocalstorage.sqlite' vitest run",
    "test-watch": "pnpm build-local-storage && NODE_OPTIONS='--localstorage-file=.tmp/testlocalstorage.sqlite' vitest watch",
    "build-only": "vite-ssg build",
    "type-check": "vue-tsc --build",
    "type-watch": "vue-tsc --watch",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.3",
    "@vueuse/core": "^15.0.0",
    "marked": "^18.1.1",
    "smol-toml": "^1.9.1",
    "ts-dedent": "^2.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "beasties": "^0.5.5",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "eslint-plugin-oxlint": "~1.89.0",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.89.0",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-ssg": "^28.3.0",
    "vite-ssg-sitemap": "^0.10.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
