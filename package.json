{
  "name": "jessbarrett.ca",
  "version": "1.8.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-local-storage": "mkdir -p .tmp",
    "test": "pnpm build-local-storage && NODE_OPTIONS='--localstorage-file=.tmp/testlocalstorage.sqlite' vitest run",
    "test-watch": "pnpm build-local-storage && NODE_OPTIONS='--localstorage-file=.tmp/testlocalstorage.sqlite' vitest watch",
    "build-only": "vite-ssg build",
    "type-check": "vue-tsc --build",
    "type-watch": "vue-tsc --watch",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.0",
    "@vueuse/core": "^14.4.0",
    "marked": "^18.0.10",
    "smol-toml": "^1.8.0",
    "ts-dedent": "^2.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "beasties": "^0.4.3",
    "daisyui": "^5.7.21",
    "eslint": "^10.9.0",
    "eslint-plugin-oxlint": "~1.75.0",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.75.0",
    "prettier": "3.9.6",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-ssg": "^28.3.0",
    "vite-ssg-sitemap": "^0.10.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
