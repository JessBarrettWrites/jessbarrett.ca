{
  "name": "jessbarrett.ca",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "run-p dev:*",
    "dev:site": "vite",
    "dev:admin": "vite build --config vite.admin.config.ts --watch --mode development",
    "build": "pnpm build-admin && run-p type-check \"build-only {@}\" --",
    "build-admin": "vite build --config vite.admin.config.ts",
    "preview": "vite preview",
    "build-local-storage": "mkdir -p .tmp",
    "test": "pnpm build-local-storage && NODE_OPTIONS='--localstorage-file=.tmp/testlocalstorage.sqlite' vitest run",
    "test-watch": "pnpm build-local-storage && NODE_OPTIONS='--localstorage-file=.tmp/testlocalstorage.sqlite' vitest watch",
    "build-only": "vite-ssg build",
    "type-check": "vue-tsc --build",
    "type-watch": "vue-tsc --watch",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/ .storybook/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.17",
    "@vueuse/core": "^15.0.0",
    "marked": "^18.2.0",
    "smol-toml": "^1.9.1",
    "ts-dedent": "^2.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.2.4",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/vue3-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "beasties": "^0.5.5",
    "daisyui": "^5.8.1",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "~1.93.0",
    "eslint-plugin-storybook": "^10.6.7",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.93.0",
    "prettier": "3.10.0",
    "sharp": "^0.35.5",
    "storybook": "^10.6.7",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-ssg": "^28.3.0",
    "vite-ssg-sitemap": "^0.10.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "yaml": "^2.9.1"
  }
}
