{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", ".storybook/preview.ts", ".storybook/manager.ts", ".storybook/virtual-modules.d.ts"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "rootDir": "./",

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
